# Copy to infra/docker/.env for local development.
# NEVER commit the real .env file (it is gitignored).

# --- Required ---------------------------------------------------------------

# Shared by auth-service, gateway, risk-engine, execution-engine, scheduler.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=2x5IPxlw0UKSYwv7k0hYarO0t60Am5m2ZiS77dEiCnag_B2jijrhg8GnJO-R2rMW

# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console > APIs & Services > Credentials. Authorized redirect URI must
# match GOOGLE_REDIRECT_URI below exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/oauth/google/callback

# --- Optional tunables (docker-compose.yml falls back to these defaults) ----
# Uncomment to override; every var maps 1:1 to a service env var.

# GRAFANA_ADMIN_PASSWORD=admin
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# gateway
# RATE_LIMIT_CAPACITY=60
# RATE_LIMIT_REFILL_PER_SECOND=1.0
# PROXY_TIMEOUT_SECONDS=30

# risk-engine
# PORTFOLIO_ENGINE_TIMEOUT=5
# CB_ERROR_WINDOW_SECONDS=300

# portfolio-engine
# DEFAULT_STARTING_CASH=100000
# MAX_RETURN_POINTS=500

# execution-engine (live trading stays OFF unless you flip both of these
# knowingly - mandatory progression is backtest -> paper -> live)
# EXECUTION_MODE=paper
# EXECUTION_LIVE_ENABLED=false
# EXECUTION_MAX_CHILD_SIZE=0
# EXECUTION_RETRY_MAX_ATTEMPTS=3
# EXECUTION_RETRY_BASE_DELAY=0.2
# EXECUTION_RETRY_MAX_DELAY=5.0
# EXECUTION_RETRY_JITTER=0.25
# EXECUTION_TRANSPORT_TIMEOUT=10

# paper-trading fill model
# PAPER_SPREAD_BPS=2.0
# PAPER_SLIPPAGE_BPS=1.0
# PAPER_SIZE_IMPACT_BPS_PER_UNIT=0.0
# PAPER_COMMISSION_BPS=1.0
# PAPER_COMMISSION_PER_UNIT=0.0
# PAPER_MAX_FILL_QUANTITY=0.0
# PAPER_LATENCY_MS=0.0
# PAPER_DEFAULT_STARTING_CASH=100000
# PAPER_ALLOW_SHORT=true

# backtester
# BACKTESTER_MAX_BARS=20000

# ai-engine
# AI_REGIME_SYMBOLS=
# UNDERPERF_MIN_TRADES=30
# UNDERPERF_SHARPE_THRESHOLD=0.0
# UNDERPERF_MAX_DRAWDOWN=0.20

# optimizer
# PROMOTION_THRESHOLD=1.05
# MAX_DRAWDOWN_TOLERANCE=0.20
# OPTIMIZER_SYNC_BUDGET=32
# OPTIMIZER_SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001

# scheduler
# SCHEDULER_AUTOSTART=true
# HEALTH_PING_URLS=

# notification-service (canales de alertas; vacios = canal deshabilitado)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@tudominio.com
# TELEGRAM_BOT_TOKEN=
# WEBHOOK_SIGNING_DEFAULT_SECRET=
# NOTIFY_MAX_RETRIES=3
# NOTIFY_RETRY_BACKOFF=0.5
# NOTIFY_INGEST_TOKEN=

# trading-engine (orquestador de bots)
# TRADING_HTTP_TIMEOUT=10
# BOT_MAX_CONSECUTIVE_ERRORS=5
# BOT_BAR_LOOKBACK=100

# broker-connectors / Binance (defaults en codigo: testnet para demo,
# api.binance.com para real; ver services/broker-connectors/README-binance.md)
# BINANCE_API_URL=https://api.binance.com
# BINANCE_TESTNET_URL=https://testnet.binance.vision
# BINANCE_WS_URL=wss://stream.binance.com:9443
# BINANCE_TESTNET_WS_URL=wss://stream.testnet.binance.vision

# Almacen de credenciales de broker: memory (default, en memoria) o db
# (cifrado Fernet, persistente). Para db, generar la clave con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_STORE=db
# BROKER_CRED_KEY=
