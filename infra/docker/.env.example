# Copy to infra/docker/.env for local development.
# NEVER commit the real .env file (it is gitignored).

# --- Required ---------------------------------------------------------------

# Shared by auth-service, gateway, risk-engine, execution-engine, scheduler.
# SIN VALOR AQUI A PROPOSITO: este fichero esta versionado, asi que cualquier
# secreto escrito aqui es publico, y con el se pueden FIRMAR tokens de
# administrador. Genera el tuyo en el .env real (que si esta gitignored):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console > APIs & Services > Credentials. Authorized redirect URI must
# match GOOGLE_REDIRECT_URI below exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/oauth/google/callback

# --- Operador unico (panel privado) -----------------------------------------
# El sistema lo controla UN solo operador. La contrasena se guarda solo como
# hash bcrypt (nunca en texto plano). Igual que JWT_SECRET, aqui no va ningun
# valor: un hash versionado es un hash publico, y con la contrasena conocida
# de al lado cualquiera entraba al panel. Genera el tuyo:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'TU_PASSWORD', bcrypt.gensalt()).decode())"
# Luego cambiala desde el panel (Seguridad) o POST /auth/change_password.
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=

# --- Cookie de sesion del navegador (gateway, patron BFF) --------------------
# El refresh token vive en una cookie httpOnly, no en localStorage. Secure debe
# ser true en produccion; por defecto es false para que funcione sobre http en
# local (los navegadores descartan cookies Secure en http).
# SESSION_COOKIE_SECURE=true
# lax sirve si dashboard y gateway comparten dominio (el puerto da igual). Si el
# frontend esta en otro sitio hace falta none, que exige Secure=true.
# SESSION_COOKIE_SAMESITE=lax

# Bloqueo anti-fuerza-bruta del login (por IP):
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_ATTEMPT_WINDOW=600
# LOGIN_BLOCK_SECONDS=1800

# --- Optional tunables (docker-compose.yml falls back to these defaults) ----
# Uncomment to override; every var maps 1:1 to a service env var.

# GRAFANA_ADMIN_PASSWORD=admin
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# gateway
# RATE_LIMIT_CAPACITY=60
# RATE_LIMIT_REFILL_PER_SECOND=1.0
# PROXY_TIMEOUT_SECONDS=30

# risk-engine
# PORTFOLIO_ENGINE_TIMEOUT=5
# CB_ERROR_WINDOW_SECONDS=300

# portfolio-engine
# DEFAULT_STARTING_CASH=100000
# MAX_RETURN_POINTS=500

# execution-engine (live trading stays OFF unless you flip both of these
# knowingly - mandatory progression is backtest -> paper -> live)
# EXECUTION_MODE=paper
# EXECUTION_LIVE_ENABLED=false
# EXECUTION_MAX_CHILD_SIZE=0
# EXECUTION_RETRY_MAX_ATTEMPTS=3
# EXECUTION_RETRY_BASE_DELAY=0.2
# EXECUTION_RETRY_MAX_DELAY=5.0
# EXECUTION_RETRY_JITTER=0.25
# EXECUTION_TRANSPORT_TIMEOUT=10

# paper-trading fill model
# PAPER_SPREAD_BPS=2.0
# PAPER_SLIPPAGE_BPS=1.0
# PAPER_SIZE_IMPACT_BPS_PER_UNIT=0.0
# PAPER_COMMISSION_BPS=1.0
# PAPER_COMMISSION_PER_UNIT=0.0
# PAPER_MAX_FILL_QUANTITY=0.0
# PAPER_LATENCY_MS=0.0
# PAPER_DEFAULT_STARTING_CASH=100000
# PAPER_ALLOW_SHORT=true

# backtester
# BACKTESTER_MAX_BARS=20000

# ai-engine
# AI_REGIME_SYMBOLS=
# UNDERPERF_MIN_TRADES=30
# UNDERPERF_SHARPE_THRESHOLD=0.0
# UNDERPERF_MAX_DRAWDOWN=0.20

# optimizer
# PROMOTION_THRESHOLD=1.05
# MAX_DRAWDOWN_TOLERANCE=0.20
# OPTIMIZER_SYNC_BUDGET=32
# OPTIMIZER_SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001

# scheduler
# SCHEDULER_AUTOSTART=true
# HEALTH_PING_URLS=
# AUTONOMY_TICK_CRON=*/5 * * * *

# autonomy-controller (el cerebro autonomo detras del interruptor del panel)
# Universo y presupuesto de riesgo que gestiona automaticamente en paper:
# AUTONOMY_SYMBOLS=BTCUSDT
# AUTONOMY_TIMEFRAME=1h
# AUTONOMY_MARKET=crypto
# AUTONOMY_BROKER=binance
# AUTONOMY_ACCOUNT_ID=autonomy
# AUTONOMY_TOP_N=1
# AUTONOMY_MAX_ACTIVE_BOTS=5
# Auto-halt global (red de seguridad): si el drawdown agregado supera este
# umbral, la automatizacion se detiene sola y exige reset admin (0 desactiva).
# AUTONOMY_MAX_DRAWDOWN=0.25
# Auto-halt por perdida diaria como fraccion del equity (0 desactiva, opt-in).
# AUTONOMY_MAX_DAILY_LOSS=0.05
# Asignacion de capital (P7): la IA decide cuanto capital/riesgo va a cada
# estrategia segun su peso. Fraccion desplegable del presupuesto, riesgo base
# por operacion (se reparte por peso), y tope por simbolo.
# AUTONOMY_DEPLOYABLE_FRACTION=1.0
# AUTONOMY_BASE_RISK_PER_TRADE=0.01
# AUTONOMY_MAX_EXPOSURE_PER_SYMBOL=0.5
# Gates paper->live (P18): el paso a dinero real solo se permite si el track
# record en paper cumple TODOS estos umbrales (ademas de confirmacion admin y
# de EXECUTION_LIVE_ENABLED en execution-engine).
# Dias con ACTIVIDAD REAL en paper (no dias de calendario): un bot que se
# enciende un rato cada tantos dias no acumula historial.
# AUTONOMY_MIN_PAPER_DAYS=14
# Drawdown PEOR del periodo (no el actual), muy por debajo del auto-halt de
# 0.25: un sistema que ya roza el freno de emergencia no se promueve.
# AUTONOMY_MAX_PROMOTE_DRAWDOWN=0.10
# Empatar no es motivo para arriesgar dinero real:
# AUTONOMY_MIN_PAPER_RETURN=0.02
# Minimo de operaciones cerradas: 14 dias con 3 fills afortunados no son un
# historial (0 desactiva el gate).
# AUTONOMY_MIN_CLOSED_TRADES=30
# Sharpe POR OPERACION (media del PnL realizado / su desviacion), no anualizado.
# Vacio = gate desactivado; si faltan datos el gate falla en cerrado.
# AUTONOMY_MIN_SHARPE=0.15
# Coherencia paper vs backtest: DESACTIVADO a proposito porque todavia no hay
# nada que alimente el baseline de backtest en build_readiness. Activarlo hoy
# no endurece la promocion, la vuelve imposible. Ver config.py.
# AUTONOMY_BACKTEST_COHERENCE=

# notification-service (canales de alertas; vacios = canal deshabilitado)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@tudominio.com
# TELEGRAM_BOT_TOKEN=
# WEBHOOK_SIGNING_DEFAULT_SECRET=
# NOTIFY_MAX_RETRIES=3
# NOTIFY_RETRY_BACKOFF=0.5
# NOTIFY_INGEST_TOKEN=

# trading-engine (orquestador de bots)
# TRADING_HTTP_TIMEOUT=10
# BOT_MAX_CONSECUTIVE_ERRORS=5
# BOT_BAR_LOOKBACK=100

# broker-connectors / Binance (defaults en codigo: testnet para demo,
# api.binance.com para real; ver services/broker-connectors/README-binance.md)
# BINANCE_API_URL=https://api.binance.com
# BINANCE_TESTNET_URL=https://testnet.binance.vision
# BINANCE_WS_URL=wss://stream.binance.com:9443
# BINANCE_TESTNET_WS_URL=wss://stream.testnet.binance.vision

# Almacen de credenciales de broker: memory (default, en memoria) o db
# (cifrado Fernet, persistente). Para db, generar la clave con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_STORE=db
# BROKER_CRED_KEY=
